# ============================================================================
# Open OnDemand on AWS - Configuration Template
# ============================================================================
# Copy this file to create environment-specific configurations:
#   cp .config-example.env .configs/dev.env
#
# Usage:
#   ENV=dev ./deploy.sh
#   CONFIG_FILE=.configs/custom.env ./deploy.sh
# ============================================================================

# ----------------------------------------------------------------------------
# Stack Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# CloudFormation stack name (must be unique per region/account)
STACK_NAME="ood-stack-example"

# Slurm version to deploy
SLURM_VERSION="25.05.5"

# Git branch to deploy from
BRANCH="main"

# Domain configuration for Open OnDemand
DOMAIN_NAME="example"
TOP_LEVEL_DOMAIN="local"

# ----------------------------------------------------------------------------
# Network Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# VPC ID where OOD will be deployed
VPC="vpc-xxxxxxxxxxxxxxxxx"

# Comma-separated list of public subnet IDs (for ALB)
PUBLIC_SUBNETS="subnet-xxx,subnet-yyy,subnet-zzz"

# Comma-separated list of private subnet IDs (for OOD instances)
PRIVATE_SUBNETS="subnet-aaa,subnet-bbb,subnet-ccc"

# S3 bucket for Application Load Balancer access logs
LOAD_BALANCER_LOG_BUCKET="alb-access-logs-bucket-name"

# ----------------------------------------------------------------------------
# Active Directory / LDAP Configuration (REQUIRED)
# ----------------------------------------------------------------------------
# ARN of the Secrets Manager secret containing AD admin password
AD_ADMIN_SECRET_ARN="arn:aws:secretsmanager:us-east-1:123456789012:secret:ad-admin-password-xxxxx"

# Network Load Balancer endpoint for LDAP
LDAP_NLB_ENDPOINT="ldap-nlb.example.elb.us-east-1.amazonaws.com"

# ----------------------------------------------------------------------------
# Storage Configuration (Optional)
# ----------------------------------------------------------------------------
# EFS filesystem ID for shared storage
EFS_FILESYSTEM_ID="fs-xxxxxxxxxxxxxxxxx"

# EFS filesystem ARN
EFS_FILESYSTEM_ARN="arn:aws:elasticfilesystem:us-east-1:123456789012:file-system/fs-xxxxxxxxxxxxxxxxx"

# ----------------------------------------------------------------------------
# Optional Parameters
# ----------------------------------------------------------------------------
# AWS PCS (Parallel Computing Service) cluster security group
# PCS_CLUSTER_SECURITY_GROUP="sg-xxxxxxxxxxxxxxxxx"

# Slurm accounting database configuration (if using)
# SLURM_ACCOUNTING_DB_SECRET="arn:aws:secretsmanager:region:account:secret:xxx"
# SLURM_ACCOUNTING_DB_SECRET_PASSWORD="arn:aws:secretsmanager:region:account:secret:xxx"
# SLURM_ACCOUNTING_DB_SECURITY_GROUP="sg-xxxxxxxxxxxxxxxxx"

# Custom domain name for the OOD website (requires HostedZoneId)
# WEBSITE_DOMAIN_NAME="ood.example.com"

# Route53 Hosted Zone ID for custom domain (requires WebsiteDomainName)
# HOSTED_ZONE_ID="Z1234567890ABC"

# Munge key secret ARN for Slurm authentication
# MUNGE_KEY_SECRET_ARN="arn:aws:secretsmanager:region:account:secret:munge-key-xxx"
